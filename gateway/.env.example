# Copy to .env (never commit it). The service role key bypasses row level security: keep it on the plant computer only.
SUPABASE_URL=https://rciyzoosuncncecqmqaq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SYSTEM_ID=            # optional, defaults to the first system

PLC_HOST=192.168.0.10
PLC_PORT=502
PLC_UNIT=1

POLL_SECONDS=10         # pump, line and water-quality tags
JAR_POLL_SECONDS=60     # the 432 jar tags on the RS-485 bus

# 4-20 mA scaling of %IW analog inputs. 5530 to 27648 suits Siemens-style cards; change for your card.
AI_RAW_4MA=5530
AI_RAW_20MA=27648
AI_FUNCTION=3           # 3 = holding registers, 4 = input registers
# %MW jar registers hold value x REG_SCALE as a signed 16-bit integer; -32768 means sensor fault.
REG_SCALE=100
# Added to the register number in plc_address (for PLCs whose Modbus map is shifted)
IW_BASE=0
MW_BASE=0
QW_BASE=0
ZERO_TOL=0.01           # a limit of 0 (none allowed) only alarms above this
